      "pattern_id": "rule",
      "message": "match",
      "pattern": "language go\n`x`",
      "sources": [
        {
          "path": "a.go",
          "text": "package p\nvar x=1\n"
        }
      ],
      "execution": {
        "mode": "both"
      },
      "expected": {
        "findings": [
          {
            "path": "a.go",
            "start_byte": 14,
            "end_byte": 15,
            "start_line": 2,
            "start_column": 5,
            "end_line": 2,
            "end_column": 6,
            "pattern_id": "rule",
            "message": "match",
            "bindings": {}
          }
        ],
        "diagnostics": []
      }
    },
