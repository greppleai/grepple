    {
      "name": "scanner/crlf-interior-trivia",
      "description": "CRLF and interior comments remain in source spans while edge trivia is excluded.",
      "features": [
        "positive",
        "comments",
        "crlf",
        "interior-trivia"
      ],
      "pattern_id": "rule",
      "message": "match",
      "pattern": "language go\n`pair(a,b)`",
      "sources": [
        {
          "path": "main.go",
          "text": "package p\r\nfunc f(){ pair(a, /* 茶 */ b) }\r\n"
        }
      ],
      "execution": {
        "mode": "local"
      },
      "expected": {
        "findings": [
