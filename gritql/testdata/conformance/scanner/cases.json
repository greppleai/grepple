{
  "schema_version": 1,
  "suite": "scanner",
  "provenance": {
    "kind": "grepple-original",
    "note": "Grepple-original fixture derived solely from docs/gritql-compatibility.md; no upstream source text was copied."
  },
  "cases": [
    {
      "name": "scanner/utf8-range",
      "description": "Offsets are UTF-8 bytes while columns count Unicode scalars.",
      "features": [
        "positive",
        "utf8-ranges"
      ],
      "pattern_id": "rule",
      "message": "match",
      "pattern": "language go\n`café`",
      "sources": [
        {
          "path": "utf8.go",
          "text": "package p\nvar café = \"茶\"\n"
        }
      ],
      "execution": {
        "mode": "local"
      },
      "expected": {
        "findings": [
          {
            "path": "utf8.go",
            "start_byte": 14,
            "end_byte": 19,
            "start_line": 2,
            "start_column": 5,
            "end_line": 2,
            "end_column": 9,
            "pattern_id": "rule",
            "message": "match",
            "bindings": {}
          }
        ],
        "diagnostics": []
      }
    },
    {
      "name": "scanner/comments-are-trivia",
      "description": "Comments are omitted as trivia and do not expand ranges.",
      "features": [
        "positive",
        "comments"
      ],
      "pattern_id": "rule",
      "message": "match",
      "pattern": "language go\n`x`",
      "sources": [
        {
          "path": "comments.go",
          "text": "package p\n// 茶 comment\nvar x = 1 // tail\n"
        }
      ],
      "execution": {
        "mode": "local"
      },
      "expected": {
        "findings": [
          {
            "path": "comments.go",
            "start_byte": 29,
            "end_byte": 30,
            "start_line": 3,
            "start_column": 5,
            "end_line": 3,
            "end_column": 6,
            "pattern_id": "rule",
            "message": "match",
            "bindings": {}
          }
        ],
        "diagnostics": []
      }
    },
    {
      "name": "scanner/invalid-utf8",
      "description": "Invalid source bytes reject the complete file.",
      "features": [
        "negative"
      ],
      "pattern_id": "rule",
      "message": "match",
      "pattern": "language go\n`x`",
      "sources": [
        {
          "path": "bad.go",
          "bytes_base64": "cGFja2FnZSBwCv8="
        }
      ],
      "execution": {
        "mode": "local"
      },
      "expected": {
        "findings": [],
        "diagnostics": [
          {
            "code": "SOURCE_INVALID_UTF8",
            "class": "source",
            "severity": "error",
            "message": "source is not valid UTF-8",
            "pattern_id": "rule",
            "path": "bad.go",
            "range": null
          }
        ]
      }
    },
    {
      "name": "scanner/source-parse-error",
      "description": "Only the earliest parser error is emitted and no partial findings survive.",
      "features": [
        "negative"
      ],
      "pattern_id": "rule",
      "message": "match",
      "pattern": "language go\n`x`",
      "sources": [
        {
          "path": "bad.go",
          "text": "package p\nfunc {"
        }
      ],
      "execution": {
        "mode": "local"
      },
      "expected": {
        "findings": [],
        "diagnostics": [
          {
            "code": "SOURCE_PARSE",
            "class": "source",
            "severity": "error",
            "message": "expected function name",
            "pattern_id": "rule",
            "path": "bad.go",
            "range": {
              "start_byte": 15,
              "end_byte": 16,
              "start_line": 2,
              "start_column": 6,
              "end_line": 2,
              "end_column": 7
            }
          }
        ]
      }
    },
    {
      "name": "scanner/limit-source-bytes",
      "description": "A file-scoped resource failure discards that file.",
      "features": [
        "negative",
        "limit-source-bytes"
      ],
      "pattern_id": "rule",
      "message": "match",
      "pattern": "language go\n`x`",
      "sources": [
        {
          "path": "main.go",
          "text": "package p\nvar x=1\n"
        }
      ],
      "execution": {
        "mode": "local",
        "limits": {
          "source_bytes": 4
        }
      },
      "expected": {
        "findings": [],
        "diagnostics": [
          {
            "code": "LIMIT_SOURCE_BYTES",
            "class": "resource",
            "severity": "error",
            "message": "source exceeds effective byte limit",
            "pattern_id": "rule",
            "path": "main.go",
            "range": null
          }
        ]
      }
    },
