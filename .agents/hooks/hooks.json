{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/install-cli.mjs", "${CLAUDE_PLUGIN_DATA}"],
            "timeout": 180,
            "statusMessage": "Checking Grepple CLI release"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/grep-guard.mjs", "${CLAUDE_PLUGIN_DATA}"],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
