# Copy to .env before running ./start-local.sh or docker compose.

# Host-side grepple clients should search through the router.
GREPPLE_SERVER=http://127.0.0.1:8080
GREPPLE_ROUTER_PORT=8080
GREPPLE_SHARD_A_PORT=8787
GREPPLE_SHARD_B_PORT=8788

# Shared parser concurrency per shard process.
GREPPLE_WORKERS=8

# Set to host only if Docker's default build network cannot resolve Go modules.
# GREPPLE_BUILD_NETWORK=host

# GitHub token used for organization discovery and private HTTPS clone/pull.
GITHUB_TOKEN=

# Repositories to keep checked out, as comma-separated owner/name values.
WATCH_REPOS=octocat/Hello-World,octocat/Spoon-Knife

# Organizations to discover and keep indexed, comma-separated.
WATCH_ORGS=

# Optional GitHub webhook signature secret and index-job concurrency.
GREPPLE_WEBHOOK_SECRET=
GREPPLE_WEBHOOK_CONCURRENCY=4

# Log level: error (prod-quiet) | warn | info | debug. info shows the periodic
# reconcile discovery summary (discovered/archived/disabled/otherOrg), webhook
# actions, and one JSON line per search with per-shard timings. Output is always JSON.
GREPPLE_LOG_LEVEL=info

# Optional GitHub App discovery/auth (alternative to GITHUB_TOKEN + WATCH_*).
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATIONS=org:installationId
# Provide the RSA private key one of two ways:
#   inline PEM:
# GITHUB_APP_PRIVATE_KEY=
#   or (preferred) as a file: uncomment GITHUB_APP_PRIVATE_KEY_FILE and the
#   volume mount in docker-compose.yml. It defaults to github-app.pem in the
#   repo root (gitignored); override the host path here if it lives elsewhere.
# GITHUB_APP_PRIVATE_KEY_PATH=./github-app.pem

# GitHub OAuth/App client ID (public) advertised to CLIs at GET /auth/config so
# `grepple login --url <server>` runs the device flow with no local client ID.
# GITHUB_CLIENT_ID=
# GitHub App client secret (secret!) enabling POST /auth/refresh, so the CLI can
# silently renew an expiring `grepple login` token instead of re-authenticating
# every ~8h. Only needed when the App has "Expire user authorization tokens" on.
# Provide inline or via a mounted file (GITHUB_CLIENT_SECRET_FILE).
# GITHUB_CLIENT_SECRET=

# Require a `grepple login` token whose user is a member of an authorized org for
# the CLI-facing /public/* endpoints (off by default for local dev). When
# GREPPLE_AUTH_ORGS is empty the allowed orgs are derived from WATCH_ORGS/WATCH_REPOS
# and any GitHub App installations.
# GREPPLE_REQUIRE_AUTH=false
# GREPPLE_AUTH_ORGS=your-org
