  "cases": [
    {
      "name": "api/finding-order-and-dedup",
      "description": "Findings use the complete order key and byte-identical duplicates collapse.",
      "features": [
        "positive",
        "ordering",
        "dedup"
      ],
      "pattern_id": "r",
      "message": "m",
      "pattern": "language go\nor { `x`, `x` }",
      "sources": [
        {
          "path": "z.go",
          "text": "package p\nvar x=2\n"
        },
        {
          "path": "a.go",
          "text": "package p\nvar x=1\n"
        }
      ],
      "execution": {
        "mode": "local"
      },
      "expected": {
        "findings": [
          {
            "path": "a.go",
            "start_byte": 14,
            "end_byte": 15,
            "start_line": 2,
            "start_column": 5,
            "end_line": 2,
            "end_column": 6,
            "pattern_id": "r",
            "message": "m",
            "bindings": {}
          },
          {
            "path": "z.go",
            "start_byte": 14,
            "end_byte": 15,
            "start_line": 2,
            "start_column": 5,
            "end_line": 2,
            "end_column": 6,
            "pattern_id": "r",
            "message": "m",
            "bindings": {}
          }
        ],
        "diagnostics": []
      }
    },
